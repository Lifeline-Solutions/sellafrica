<% content_for :title, "Create your account · SellAfrica" %>

<%
  field_base = "h-14 w-full rounded-2xl border-2 bg-sand-50 pl-12 text-base text-ink placeholder:text-zinc-500 transition focus:bg-white focus:outline-none focus:ring-0"
  field_ok   = "border-sand-200 hover:border-zinc-300 focus:border-ink"
  field_bad  = "border-brand bg-[#FFF6F7] focus:border-brand"
  field_class = ->(attr) { [field_base, resource.errors[attr].any? ? field_bad : field_ok].join(" ") }
%>

<!-- Mobile brand strip (hidden on desktop, where the side panel shows) -->
<div class="shuka h-3 lg:hidden" aria-hidden="true"></div>

<div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 sm:py-10 lg:min-h-[calc(100vh-9rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-10 lg:px-8 lg:py-12">

  <!-- ── Form card ────────────────────────────────── -->
  <div class="flex items-center justify-center">
    <div class="w-full max-w-md lg:max-w-lg lg:rounded-[32px] lg:border lg:border-sand-200 lg:bg-white lg:p-12 lg:shadow-[0_24px_60px_-30px_rgba(24,25,27,.25)]">

      <span class="inline-flex items-center gap-2 rounded-full bg-[#FDF1C7] px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-[#6B4E00]">
        Free to join
      </span>

      <h1 class="mt-5 font-display text-4xl font-black leading-none tracking-tight text-ink sm:text-5xl">Create your account</h1>
      <p class="mt-3 text-base leading-relaxed text-zinc-600">
        Shop from makers across Africa — or open your own shop in minutes.
      </p>

      <!-- Error summary (replaces devise/shared/error_messages) -->
      <% if resource.errors.any? %>
        <div role="alert" class="mt-6 rounded-2xl border border-brand/20 bg-[#FBE3E6] px-4 py-3.5 text-sm text-brand-dark">
          <p class="flex items-center gap-2 font-bold">
            <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.5"/></svg>
            Please fix <%= pluralize(resource.errors.count, "thing") %> below
          </p>
          <ul class="mt-2 list-disc space-y-1 pl-9 font-medium">
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                   html: { class: "mt-8 flex flex-col gap-5", data: { controller: "password-check" } }) do |f| %>

        <!-- Email -->
        <div class="flex flex-col gap-2">
          <%= f.label :email, "Email address", class: "text-sm font-bold text-ink" %>
          <div class="relative">
            <svg class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
                              placeholder: "you@example.com",
                              aria: { invalid: resource.errors[:email].any?, describedby: ("email_error" if resource.errors[:email].any?) },
                              class: "#{field_class.(:email)} pr-4" %>
          </div>
          <% if resource.errors[:email].any? %>
            <p id="email_error" class="text-sm font-medium text-brand">Email <%= resource.errors[:email].first %></p>
          <% end %>
        </div>

        <!-- Password -->
        <div class="flex flex-col gap-2" data-controller="password-toggle">
          <%= f.label :password, class: "text-sm font-bold text-ink" %>
          <div class="relative">
            <svg class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            <%= f.password_field :password, autocomplete: "new-password", required: true,
                                 minlength: @minimum_password_length,
                                 placeholder: "Create a password",
                                 aria: { describedby: "password_hint" },
                                 data: { password_toggle_target: "input", password_check_target: "password",
                                         action: "input->password-check#update" },
                                 class: "#{field_class.(:password)} pr-14" %>
            <button type="button" data-action="password-toggle#toggle" data-password-toggle-target="button"
                    aria-label="Show password" aria-pressed="false"
                    class="absolute right-1.5 top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-xl text-zinc-600 hover:bg-sand-100 hover:text-ink">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>

          <!-- Live strength bar -->
          <div class="flex gap-1.5" aria-hidden="true">
            <% 4.times do %>
              <span data-password-check-target="bar" class="h-1.5 flex-1 rounded-full bg-sand-200 transition-colors"></span>
            <% end %>
          </div>
          <p id="password_hint" class="text-sm text-zinc-600" data-password-check-target="hint"
             data-min="<%= @minimum_password_length || 6 %>">
            <% if resource.errors[:password].any? %>
              <span class="font-medium text-brand">Password <%= resource.errors[:password].first %></span>
            <% else %>
              At least <%= @minimum_password_length || 6 %> characters. Mixing letters, numbers and symbols makes it stronger.
            <% end %>
          </p>
        </div>

        <!-- Confirm password -->
        <div class="flex flex-col gap-2">
          <%= f.label :password_confirmation, "Confirm password", class: "text-sm font-bold text-ink" %>
          <div class="relative">
            <svg class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
                                 placeholder: "Type it again",
                                 aria: { describedby: "match_hint" },
                                 data: { password_check_target: "confirmation", action: "input->password-check#update" },
                                 class: "#{field_class.(:password_confirmation)} pr-12" %>
            <svg data-password-check-target="tick" class="pointer-events-none absolute right-4 top-1/2 hidden size-5 -translate-y-1/2 text-[#1E7A46]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
          </div>
          <p id="match_hint" data-password-check-target="match" class="min-h-5 text-sm font-medium" aria-live="polite">
            <% if resource.errors[:password_confirmation].any? %>
              <span class="text-brand">Passwords <%= resource.errors[:password_confirmation].first.sub(/\Adoesn't match Password\z/, "don't match") %></span>
            <% end %>
          </p>
        </div>

        <!-- Terms (browser-checked only; no database column needed) -->
        <label class="flex cursor-pointer items-start gap-3">
          <input type="checkbox" required class="mt-0.5 size-5 shrink-0 rounded-md border-2 border-sand-200 accent-brand">
          <span class="text-sm leading-relaxed text-zinc-700">
            I agree to the <%= link_to "Terms", "#", class: "font-semibold text-ink underline hover:text-brand" %>
            and <%= link_to "Privacy Policy", "#", class: "font-semibold text-ink underline hover:text-brand" %>.
          </span>
        </label>

        <%= f.button type: "submit",
                     data: { turbo_submits_with: "Creating your account…" },
                     class: "group mt-1 flex h-14 w-full items-center justify-center gap-2 rounded-2xl bg-brand text-base font-bold text-white transition hover:bg-brand-dark disabled:cursor-wait disabled:opacity-70" do %>
          Create account
          <svg class="size-5 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        <% end %>
      <% end %>

      <p class="mt-8 text-center text-[15px] text-zinc-600">
        Already have an account?
        <%= link_to "Log in", new_session_path(resource_name), class: "font-bold text-brand hover:underline" %>
      </p>

      <% if devise_mapping.confirmable? %>
        <p class="mt-3 text-center text-sm">
          <%= link_to "Didn't get the confirmation email?", new_confirmation_path(resource_name), class: "text-zinc-600 underline hover:text-ink" %>
        </p>
      <% end %>
    </div>
  </div>

  <!-- ── Brand panel (desktop only) ───────────────── -->
  <aside class="shuka relative hidden min-h-[680px] flex-col justify-between overflow-hidden rounded-[32px] p-8 lg:flex" aria-label="What you get with SellAfrica">

    <div class="self-start rounded-2xl border-[3px] border-ink bg-white px-4 py-3 shadow-lg">
      <%= image_tag "sellafrica-logo-primary.png", alt: "SellAfrica", class: "h-9 w-auto" %>
    </div>

    <div class="self-end -rotate-3 rounded-2xl bg-gold px-5 py-4 shadow-xl">
      <p class="font-display text-lg font-extrabold leading-tight text-ink">Selling? It's free to start.</p>
      <p class="text-sm text-[#3A2E00]">Get paid to M-Pesa or your bank.</p>
    </div>

    <div class="flex flex-col gap-6 rounded-3xl border-[3px] border-ink bg-white p-8 shadow-2xl">
      <p class="font-display text-4xl font-black leading-[1.02] tracking-tight text-ink">
        One account.<br><span class="text-brand">Buy and sell.</span>
      </p>

      <ol class="grid gap-4">
        <% [
             ["Create your account", "Takes less than a minute."],
             ["Shop or open a shop", "Buy from makers, or list your own products from your phone."],
             ["Pay and get paid your way", "M-Pesa, Airtel Money, card or cash on delivery."]
           ].each_with_index do |(title, body), i| %>
          <li class="flex gap-4">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-ink font-display text-sm font-black text-gold"><%= i + 1 %></span>
            <div>
              <p class="font-bold text-ink"><%= title %></p>
              <p class="text-sm leading-relaxed text-zinc-600"><%= body %></p>
            </div>
          </li>
        <% end %>
      </ol>
    </div>
  </aside>

</div>