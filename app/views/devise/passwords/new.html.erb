<% content_for :title, "Reset your password · SellAfrica" %>

<% email_error = resource.errors[:email].first %>

<div class="relative min-h-[calc(100vh-9rem)] overflow-hidden">

  <!-- Shuka frame behind the card: a thin strip on phones, a wide panel on desktop -->
  <div class="shuka absolute inset-x-0 top-0 h-3 sm:h-48 lg:h-64" aria-hidden="true"></div>

  <div class="relative mx-auto flex max-w-lg flex-col px-4 pb-14 pt-8 sm:px-6 sm:pt-24 lg:pt-32">
    <div class="rounded-[28px] bg-white sm:border-[3px] sm:border-ink sm:p-10 sm:shadow-2xl lg:p-12">

      <!-- Icon -->
      <div class="flex size-16 items-center justify-center rounded-2xl bg-[#FDF1C7] text-ink">
        <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="8" cy="15" r="4"/><path d="M10.8 12.2L20 3M17 6l2 2M15 8l2 2"/>
        </svg>
      </div>

      <h1 class="mt-6 font-display text-3xl font-black leading-tight tracking-tight text-ink sm:text-4xl">
        Forgot your password?
      </h1>
      <p class="mt-3 text-base leading-relaxed text-zinc-600">
        No problem. Enter the email you signed up with and we'll send you a link to set a new one.
      </p>

      <!-- Error message -->
      <% if resource.errors.any? %>
        <div role="alert" class="mt-6 flex items-start gap-3 rounded-2xl border border-brand/20 bg-[#FBE3E6] px-4 py-3 text-sm font-medium text-brand-dark">
          <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.5"/></svg>
          <span>
            <% if email_error %>
              We couldn't find that email. Check for typos, or
              <%= link_to "create an account", new_registration_path(resource_name), class: "font-bold underline" %>.
            <% else %>
              <%= resource.errors.full_messages.to_sentence %>
            <% end %>
          </span>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name),
                   html: { method: :post, class: "mt-8 flex flex-col gap-5" }) do |f| %>

        <div class="flex flex-col gap-2">
          <%= f.label :email, "Email address", class: "text-sm font-bold text-ink" %>
          <div class="relative">
            <svg class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
                              placeholder: "you@example.com",
                              aria: { invalid: email_error.present? },
                              class: [
                                "h-14 w-full rounded-2xl border-2 bg-sand-50 pl-12 pr-4 text-base text-ink placeholder:text-zinc-500 transition focus:bg-white focus:outline-none focus:ring-0",
                                email_error ? "border-brand focus:border-brand" : "border-sand-200 hover:border-zinc-300 focus:border-ink"
                              ].join(" ") %>
          </div>
        </div>

        <%= f.button type: "submit",
                     data: { turbo_submits_with: "Sending…" },
                     class: "group flex h-14 w-full items-center justify-center gap-2 rounded-2xl bg-brand text-base font-bold text-white transition hover:bg-brand-dark disabled:cursor-wait disabled:opacity-70" do %>
          Send reset link
          <svg class="size-5 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        <% end %>
      <% end %>

      <!-- What happens next -->
      <div class="mt-8 rounded-2xl bg-sand-50 p-5">
        <p class="text-sm font-bold text-ink">What happens next</p>
        <ol class="mt-3 grid gap-3 text-sm text-zinc-700">
          <li class="flex gap-3">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-lg bg-ink text-xs font-black text-gold">1</span>
            We email you a reset link. It can take a minute or two.
          </li>
          <li class="flex gap-3">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-lg bg-ink text-xs font-black text-gold">2</span>
            Open it and choose a new password.
          </li>
          <li class="flex gap-3">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-lg bg-ink text-xs font-black text-gold">3</span>
            Nothing in your inbox? Check spam, or send it again.
          </li>
        </ol>
      </div>

      <!-- Back to log in -->
      <div class="mt-8 flex flex-col items-center gap-3 border-t border-sand-200 pt-6 text-[15px] sm:flex-row sm:justify-between">
        <%= link_to new_session_path(resource_name), class: "inline-flex items-center gap-2 font-bold text-ink hover:text-brand" do %>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
          Back to log in
        <% end %>
        <% if devise_mapping.registerable? %>
          <span class="text-zinc-600">
            New here? <%= link_to "Create an account", new_registration_path(resource_name), class: "font-bold text-brand hover:underline" %>
          </span>
        <% end %>
      </div>
    </div>

    <p class="mt-6 text-center text-sm text-zinc-600">
      Still stuck? <%= link_to "Contact support", "#", class: "font-semibold text-ink underline hover:text-brand" %>
    </p>
  </div>
</div>