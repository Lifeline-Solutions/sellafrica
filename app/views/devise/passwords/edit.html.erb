<% content_for :title, "Choose a new password · SellAfrica" %>

<%
  min_length   = @minimum_password_length || 6
  token_error  = resource.errors[:reset_password_token].first
  field_base   = "h-14 w-full rounded-2xl border-2 bg-sand-50 pl-12 text-base text-ink placeholder:text-zinc-500 transition focus:bg-white focus:outline-none focus:ring-0"
  field_class  = ->(attr) { [field_base, resource.errors[attr].any? ? "border-brand focus:border-brand" : "border-sand-200 hover:border-zinc-300 focus:border-ink"].join(" ") }
%>

<div class="relative min-h-[calc(100vh-9rem)] overflow-hidden">

  <!-- Shuka frame behind the card -->
  <div class="shuka absolute inset-x-0 top-0 h-3 sm:h-48 lg:h-64" aria-hidden="true"></div>

  <div class="relative mx-auto flex max-w-lg flex-col px-4 pb-14 pt-8 sm:px-6 sm:pt-24 lg:pt-32">
    <div class="rounded-[28px] bg-white sm:border-[3px] sm:border-ink sm:p-10 sm:shadow-2xl lg:p-12">

      <!-- Icon -->
      <div class="flex size-16 items-center justify-center rounded-2xl bg-[#FDF1C7] text-ink">
        <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><circle cx="12" cy="16" r="1.3"/>
        </svg>
      </div>

      <h1 class="mt-6 font-display text-3xl font-black leading-tight tracking-tight text-ink sm:text-4xl">
        Choose a new password
      </h1>
      <p class="mt-3 text-base leading-relaxed text-zinc-600">
        Almost done. Pick a password you haven't used before — you'll use it to log in from now on.
      </p>

      <!-- Expired / used link: the most common failure, so it gets its own message -->
      <% if token_error %>
        <div role="alert" class="mt-6 rounded-2xl border border-brand/20 bg-[#FBE3E6] px-4 py-4 text-sm text-brand-dark">
          <p class="flex items-center gap-2 font-bold">
            <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            This reset link has expired or was already used
          </p>
          <p class="mt-1.5 pl-7 font-medium">For your security, links only work once and for a limited time.</p>
          <%= link_to "Send me a new link", new_password_path(resource_name),
                      class: "ml-7 mt-3 inline-flex h-11 items-center rounded-xl bg-brand px-4 font-bold text-white hover:bg-brand-dark" %>
        </div>
      <% elsif resource.errors.any? %>
        <div role="alert" class="mt-6 flex items-start gap-3 rounded-2xl border border-brand/20 bg-[#FBE3E6] px-4 py-3 text-sm font-medium text-brand-dark">
          <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.5"/></svg>
          <span>Please fix the <%= "problem".pluralize(resource.errors.count) %> below.</span>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name),
                   html: { method: :put, class: "mt-8 flex flex-col gap-5", data: { controller: "password-check" } }) do |f| %>
        <%= f.hidden_field :reset_password_token %>

        <!-- New password -->
        <div class="flex flex-col gap-2" data-controller="password-toggle">
          <%= f.label :password, "New password", class: "text-sm font-bold text-ink" %>
          <div class="relative">
            <svg class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true,
                                 minlength: min_length, placeholder: "Create a new password",
                                 aria: { describedby: "password_hint", invalid: resource.errors[:password].any? },
                                 data: { password_toggle_target: "input", password_check_target: "password",
                                         action: "input->password-check#update" },
                                 class: "#{field_class.(:password)} pr-14" %>
            <button type="button" data-action="password-toggle#toggle" data-password-toggle-target="button"
                    aria-label="Show password" aria-pressed="false"
                    class="absolute right-1.5 top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-xl text-zinc-600 hover:bg-sand-100 hover:text-ink">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>

          <div class="flex gap-1.5" aria-hidden="true">
            <% 4.times do %>
              <span data-password-check-target="bar" class="h-1.5 flex-1 rounded-full bg-sand-200 transition-colors"></span>
            <% end %>
          </div>
          <p id="password_hint" class="text-sm text-zinc-600" data-password-check-target="hint" data-min="<%= min_length %>" aria-live="polite">
            <% if resource.errors[:password].any? %>
              <span class="font-medium text-brand">Password <%= resource.errors[:password].first %></span>
            <% else %>
              At least <%= min_length %> characters. Mixing letters, numbers and symbols makes it stronger.
            <% end %>
          </p>
        </div>

        <!-- Confirm new password -->
        <div class="flex flex-col gap-2" data-controller="password-toggle">
          <%= f.label :password_confirmation, "Confirm new password", class: "text-sm font-bold text-ink" %>
          <div class="relative">
            <svg class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
                                 placeholder: "Type it again",
                                 aria: { describedby: "match_hint", invalid: resource.errors[:password_confirmation].any? },
                                 data: { password_toggle_target: "input", password_check_target: "confirmation",
                                         action: "input->password-check#update" },
                                 class: "#{field_class.(:password_confirmation)} pr-24" %>
            <svg data-password-check-target="tick" class="pointer-events-none absolute right-14 top-1/2 hidden size-5 -translate-y-1/2 text-[#1E7A46]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
            <button type="button" data-action="password-toggle#toggle" data-password-toggle-target="button"
                    aria-label="Show password" aria-pressed="false"
                    class="absolute right-1.5 top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-xl text-zinc-600 hover:bg-sand-100 hover:text-ink">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <p id="match_hint" data-password-check-target="match" class="min-h-5 text-sm font-medium" aria-live="polite">
            <% if resource.errors[:password_confirmation].any? %>
              <span class="text-brand">Passwords don't match</span>
            <% end %>
          </p>
        </div>

        <%= f.button type: "submit",
                     data: { turbo_submits_with: "Saving…" },
                     class: "group mt-1 flex h-14 w-full items-center justify-center gap-2 rounded-2xl bg-brand text-base font-bold text-white transition hover:bg-brand-dark disabled:cursor-wait disabled:opacity-70" do %>
          Save new password
          <svg class="size-5 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        <% end %>
      <% end %>

      <!-- Tips -->
      <div class="mt-8 rounded-2xl bg-sand-50 p-5">
        <p class="text-sm font-bold text-ink">Tips for a strong password</p>
        <ul class="mt-3 grid gap-2.5 text-sm text-zinc-700">
          <li class="flex items-start gap-2.5">
            <svg class="mt-0.5 size-4 shrink-0 text-[#1E7A46]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
            Use a short phrase, like three unrelated words
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="mt-0.5 size-4 shrink-0 text-[#1E7A46]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
            Don't reuse your email or M-Pesa PIN
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="mt-0.5 size-4 shrink-0 text-[#1E7A46]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
            Avoid your name, phone number or birthday
          </li>
        </ul>
      </div>

      <!-- Back to log in -->
      <div class="mt-8 border-t border-sand-200 pt-6 text-center sm:text-left">
        <%= link_to new_session_path(resource_name), class: "inline-flex items-center gap-2 text-[15px] font-bold text-ink hover:text-brand" do %>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
          Back to log in
        <% end %>
      </div>
    </div>
  </div>
</div>