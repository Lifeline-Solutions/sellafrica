<% content_for :title, "Log in · SellAfrica" %>

<div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 lg:min-h-[calc(100vh-9rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-10 lg:px-8 lg:py-12">

  <!-- ── Form card ────────────────────────────────── -->
  <div class="flex items-center justify-center">
    <div class="w-full max-w-md lg:max-w-lg lg:rounded-[32px] lg:border lg:border-sand-200 lg:bg-white lg:p-12 lg:shadow-[0_24px_60px_-30px_rgba(24,25,27,.25)]">

      <span class="inline-flex items-center gap-2 rounded-full bg-[#FDF1C7] px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-[#6B4E00]">
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        Secure log in
      </span>

      <h1 class="mt-5 font-display text-4xl font-black leading-none tracking-tight text-ink sm:text-5xl">Welcome back</h1>
      <p class="mt-3 text-base leading-relaxed text-zinc-600">
        Log in to track orders, save favourites and manage your shop.
      </p>

      <%# Devise puts "Invalid email or password" in flash[:alert] %>
      <% if flash[:alert].present? %>
        <div role="alert" class="mt-6 flex items-start gap-3 rounded-2xl border border-brand/20 bg-[#FBE3E6] px-4 py-3 text-sm font-medium text-brand-dark">
          <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.5"/></svg>
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name),
                   html: { class: "mt-8 flex flex-col gap-5" }) do |f| %>

        <!-- Email with icon -->
        <div class="flex flex-col gap-2">
          <%= f.label :email, "Email address", class: "text-sm font-bold text-ink" %>
          <div class="relative">
            <svg class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
                              placeholder: "you@example.com",
                              class: "h-14 w-full rounded-2xl border-2 border-sand-200 bg-sand-50 pl-12 pr-4 text-base text-ink placeholder:text-zinc-500 transition hover:border-zinc-300 focus:border-ink focus:bg-white focus:outline-none focus:ring-0" %>
          </div>
        </div>

        <!-- Password with show/hide -->
        <div class="flex flex-col gap-2" data-controller="password-toggle">
          <div class="flex items-center justify-between">
            <%= f.label :password, class: "text-sm font-bold text-ink" %>
            <% if devise_mapping.recoverable? %>
              <%= link_to "Forgot password?", new_password_path(resource_name),
                          class: "text-sm font-semibold text-brand hover:underline" %>
            <% end %>
          </div>
          <div class="relative">
            <svg class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            <%= f.password_field :password, autocomplete: "current-password", required: true,
                                 placeholder: "Your password",
                                 data: { password_toggle_target: "input" },
                                 class: "h-14 w-full rounded-2xl border-2 border-sand-200 bg-sand-50 pl-12 pr-14 text-base text-ink placeholder:text-zinc-500 transition hover:border-zinc-300 focus:border-ink focus:bg-white focus:outline-none focus:ring-0" %>
            <button type="button" data-action="password-toggle#toggle" data-password-toggle-target="button"
                    aria-label="Show password" aria-pressed="false"
                    class="absolute right-1.5 top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-xl text-zinc-600 hover:bg-sand-100 hover:text-ink">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <label class="flex cursor-pointer items-center gap-3 self-start">
            <%= f.check_box :remember_me, class: "size-5 rounded-md border-2 border-sand-200 accent-brand" %>
            <span class="text-sm font-medium text-ink">Keep me logged in on this device</span>
          </label>
        <% end %>

        <%= f.button type: "submit",
                     data: { turbo_submits_with: "Logging in…" },
                     class: "group mt-2 flex h-14 w-full items-center justify-center gap-2 rounded-2xl bg-brand text-base font-bold text-white transition hover:bg-brand-dark disabled:cursor-wait disabled:opacity-70" do %>
          Log in
          <svg class="size-5 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        <% end %>
      <% end %>

      <!-- Divider -->
      <div class="my-8 flex items-center gap-4 text-xs font-semibold uppercase tracking-wider text-zinc-500">
        <span class="h-px flex-1 bg-sand-200"></span>New to SellAfrica?<span class="h-px flex-1 bg-sand-200"></span>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <% if devise_mapping.registerable? %>
          <%= link_to "Create an account", new_registration_path(resource_name),
                      class: "flex h-13 items-center justify-center rounded-2xl border-2 border-ink text-[15px] font-bold text-ink transition hover:bg-ink hover:text-white" %>
        <% end %>
        <%= link_to new_seller_path_or_fallback,
                    class: "flex h-13 items-center justify-center gap-2 rounded-2xl bg-ink text-[15px] font-bold text-white transition hover:bg-black" do %>
          <svg class="size-4 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          Open a shop
        <% end %>
      </div>

      <% if devise_mapping.confirmable? %>
        <p class="mt-6 text-center text-sm">
          <%= link_to "Didn't get the confirmation email?", new_confirmation_path(resource_name), class: "text-zinc-600 underline hover:text-ink" %>
        </p>
      <% end %>
    </div>
  </div>

  <!-- ── Brand panel (desktop only) ───────────────── -->
  <aside class="shuka relative hidden min-h-[640px] flex-col justify-between overflow-hidden rounded-[32px] p-8 lg:flex" aria-label="Why SellAfrica">

    <!-- Top: logo chip -->
    <div class="self-start rounded-2xl border-[3px] border-ink bg-white px-4 py-3 shadow-lg">
      <%= image_tag "sellafrica-logo-primary.png", alt: "SellAfrica", class: "h-9 w-auto" %>
    </div>

    <!-- Middle: tilted "tag" card, echoing the logo's luggage tag -->
    <div class="self-end -rotate-3 rounded-2xl bg-gold px-5 py-4 shadow-xl">
      <p class="font-display text-lg font-extrabold leading-tight text-ink">Pay with M-Pesa</p>
      <p class="text-sm text-[#3A2E00]">One prompt on your phone. Done.</p>
    </div>

    <!-- Bottom: main card -->
    <div class="flex flex-col gap-5 rounded-3xl border-[3px] border-ink bg-white p-8 shadow-2xl">
      <p class="font-display text-4xl font-black leading-[1.02] tracking-tight text-ink">
        Africa's makers,<br><span class="text-brand">one tap away.</span>
      </p>
      <ul class="grid gap-3 text-[15px] text-zinc-700">
        <li class="flex items-center gap-3">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-[#FBE3E6] text-brand"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg></span>
          Pay with M-Pesa, Airtel Money or card
        </li>
        <li class="flex items-center gap-3">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-[#FBE3E6] text-brand"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg></span>
          Track every parcel to your door
        </li>
        <li class="flex items-center gap-3">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-[#FBE3E6] text-brand"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg></span>
          Every shop is ID-checked before it goes live
        </li>
      </ul>
      <div class="flex flex-wrap gap-2 border-t border-sand-200 pt-5">
        <% ["M-Pesa", "Airtel Money", "Visa", "Mastercard", "Cash on delivery"].each do |m| %>
          <span class="rounded-full border border-sand-200 px-3 py-1 text-xs font-semibold text-zinc-700"><%= m %></span>
        <% end %>
      </div>
    </div>
  </aside>

</div>