<!-- ── Seller banner ───────────────────────────────── -->
<section id="sell" aria-labelledby="sell-heading" class="mx-auto max-w-7xl scroll-mt-32 px-4 pb-14 sm:px-6 lg:px-8">
  <div class="flex flex-col items-center gap-10 overflow-hidden rounded-[28px] bg-brand px-6 py-10 text-white sm:px-12 sm:py-14 lg:flex-row lg:gap-16">

    <!-- Text -->
    <div class="flex flex-1 flex-col gap-5">
      <span class="text-xs font-bold uppercase tracking-widest text-[#FDE7A1]">For sellers</span>

      <h2 id="sell-heading" class="font-display text-3xl font-black leading-[0.95] tracking-tight sm:text-5xl">
        Got something to sell? Open your shop in minutes.
      </h2>

      <ul class="flex flex-col gap-3 text-base sm:text-lg">
        <li class="flex items-center gap-3">
          <svg class="size-5 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
          List products straight from your phone
        </li>
        <li class="flex items-center gap-3">
          <svg class="size-5 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
          Get paid to M-Pesa or your bank
        </li>
        <li class="flex items-center gap-3">
          <svg class="size-5 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
          We handle delivery and tracking
        </li>
      </ul>

      <div class="mt-2 flex flex-wrap gap-3">
        <a href="/sellers/new" class="rounded-2xl bg-white px-7 py-4 font-bold text-ink transition hover:bg-sand-100">
          Open your shop
        </a>
        <a href="/selling" class="rounded-2xl border-2 border-white px-6 py-3.5 font-bold text-white transition hover:bg-white/10">
          How selling works
        </a>
      </div>
    </div>

    <!-- Tilted logo card -->
    <div class="flex aspect-square w-56 shrink-0 -rotate-3 items-center justify-center rounded-[32px] border-4 border-ink bg-white shadow-2xl transition duration-300 hover:rotate-0 sm:w-72 lg:w-80">
      <%= image_tag 'sellafrica-app-icon.png', class: 'w-[80%]' %>
    </div>

  </div>
</section>